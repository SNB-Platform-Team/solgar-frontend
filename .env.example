VITE_CLERK_PUBLISHABLE_KEY=
# Leave empty in dev — Vite proxies /sales/api/... to Django (see vite.config.ts)
# so requests stay same-origin and the session cookie is sent. Set this only
# if the API is served from a different origin than the frontend.
VITE_API_URL=
# Superset "1C — Склад" dashboard, embedded via iframe on Аналитика 1C
# (see src/features/analytics-1c). Defaults to the local dev Superset
# instance when unset — point this at the real Superset origin in prod.
VITE_SUPERSET_1C_DASHBOARD_URL=https://94.139.254.16.sslip.io/superset/dashboard/1/?standalone=true
# Olga's PowerBI report ("report_solgar"), embedded below the Superset
# dashboard on the same Аналитика 1C page. Get the embed URL from the
# PowerBI report's own Share/Embed dialog — set it here, no default.
VITE_POWERBI_DASHBOARD_URL=
# Olga's PowerBI report ("English online offline report"), shown on its own
# Power BI page (see src/features/powerbi). Has a hardcoded fallback in
# code, so this is only needed to override it (e.g. if Olga reshares it).
VITE_POWERBI_REPORT_URL=
# Management's "Общий вид Solgar" PowerBI report — a "publish to web" link
# (app.powerbi.com/view?r=...), shown on its own page (see
# src/features/powerbi-obshiy). Needs no PowerBI login. Has a hardcoded
# fallback in code, so this is only needed to override it.
VITE_POWERBI_OBSHIY_URL=
# Management's "Общий вид Nature's Bounty" PowerBI report — same convention
# as VITE_POWERBI_OBSHIY_URL above, shown on its own page (see
# src/features/powerbi-bounty). Needs no PowerBI login. Has a hardcoded
# fallback in code, so this is only needed to override it.
VITE_POWERBI_BOUNTY_URL=
# Yandex Maps JS API key, used by the Адрес-section map on Doctor/Pharmacy
# Entry (see src/components/address-map.tsx). Get one at
# https://developer.tech.yandex.ru/ — required, no fallback.
VITE_YANDEX_MAPS_API_KEY=
